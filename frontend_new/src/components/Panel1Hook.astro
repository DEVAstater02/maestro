---
---
<section class="panel" role="region" aria-label="Introduction">
  <div class="flex flex-col items-center justify-center text-center w-full h-full px-6">
    <h1 class="font-serif text-[48px] md:text-[64px] text-text-primary leading-tight max-w-[800px] mb-6">
      What if your AI actually taught you?
    </h1>
    <p class="font-sans text-[17px] md:text-[18px] text-text-secondary max-w-[560px] mb-12">
      Maestro is a voice AI tutor that builds your understanding, not just your chat history.
    </p>

    <!-- Waveform canvas - idle mode -->
    <canvas
      id="waveform-hero"
      class="w-full max-w-[900px] h-[30vh]"
      aria-label="Ambient audio waveform visualization"
    ></canvas>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute right-8 bottom-8 md:right-12 md:bottom-12">
    <span class="scroll-indicator font-sans text-[13px] text-text-secondary">
      scroll to explore &rarr;
    </span>
  </div>
</section>
