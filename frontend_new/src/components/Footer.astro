  style="background: rgba(28, 25, 23, 0.85); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);"
>
  <div class="flex items-center justify-between h-[44px] px-6 md:px-10">
    <span class="text-text-secondary text-[13px] font-sans">
      &copy; 2026 Maestro
    </span>
    <div class="flex items-center gap-4">
      <a href="/privacy" class="text-text-secondary text-[13px] font-sans hover:text-text-primary transition-colors no-underline">Privacy</a>
      <span class="text-surface-muted text-[13px]">&middot;</span>
      <a href="/terms" class="text-text-secondary text-[13px] font-sans hover:text-text-primary transition-colors no-underline">Terms</a>
      <span class="text-surface-muted text-[13px]">&middot;</span>
      <a href="https://instagram.com/maestro" aria-label="Instagram" class="text-text-secondary hover:text-text-primary transition-colors no-underline">
        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
